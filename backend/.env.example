# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Опционально: если используете рублёвый прокси вместо прямой оплаты Anthropic
# (например ProxyAPI — https://api.proxyapi.ru/anthropic), укажите его здесь.
# Оставьте пустым для прямого обращения к api.anthropic.com.
ANTHROPIC_BASE_URL=

# Avito Messenger API (developers.avito.ru)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=

# Telegram-уведомления администратору
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Firebase / Firestore
# Вставьте либо путь к JSON-файлу сервисного аккаунта, либо его содержимое целиком (в одну строку)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Авторизация в админку (простой логин/пароль, один администратор)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# Домены фронтенда, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173
