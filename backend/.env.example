# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Опционально: если используете рублёвый прокси вместо прямой оплаты Anthropic
# (например ProxyAPI — https://api.proxyapi.ru/anthropic), укажите его здесь.
# Оставьте пустым для прямого обращения к api.anthropic.com.
ANTHROPIC_BASE_URL=

# Avito Messenger API (developers.avito.ru)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=

# Instagram API with Instagram Login (Meta for Developers, отдельный вход без Facebook-страницы)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_APP_SECRET=
# Придумайте любую строку — то же значение укажете при подписке вебхука в Meta
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Telegram: уведомления + интерактивное меню управления агентом
# (группа-форум с темами — см. README) и его вебхук
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Firebase / Firestore (проект самого агента)
# Вставьте либо путь к JSON-файлу сервисного аккаунта, либо его содержимое целиком (в одну строку)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# TravelLine PMS API — реальная доступность домиков (нужен тариф с включённым PMS API)
TRAVELLINE_CLIENT_ID=
TRAVELLINE_CLIENT_SECRET=
TRAVELLINE_PROPERTY_ID=68306

# Авторизация в админку (простой логин/пароль, один администратор)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# Домены фронтенда, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173
